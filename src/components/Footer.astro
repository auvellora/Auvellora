---
// Trust signals (address, reg. nr., phone) are conventional and expected on
// Latvian SMB sites. Replace the placeholder values with the real ones.
const year = new Date().getFullYear();
---

<footer class="foot">
  <img class="branch-rule foot-branch" src="/images/branch-bone.png" alt="" width="852" height="361" aria-hidden="true" />
  <div class="wrap foot-grid">
    <div class="foot-brand">
      <img src="/images/wordmark-bone.png" alt="Auvellora" width="3001" height="1501" />
      <p>Apgaismojuma objekti no atrasta koka.<br />Darinām Rīgā, pa vienam.</p>
    </div>

    <nav class="foot-col" aria-label="Kājenes navigācija">
      <h2 class="eyebrow">Lapas</h2>
      <ul>
        <li><a href="/kolekcija/">Kolekcija</a></li>
        <li><a href="/stasts/">Stāsts</a></li>
        <li><a href="/kontakti/">Kontakti</a></li>
      </ul>
    </nav>

    <div class="foot-col">
      <h2 class="eyebrow">Sazināties</h2>
      <ul>
        <li><a href="tel:+37125400100">+371 25 400 100</a></li>
        <li><a href="mailto:studija@auvellora.lv">studija@auvellora.lv</a></li>
        <li>Miera iela 58, Rīga, LV-1013</li>
      </ul>
    </div>

    <div class="foot-col foot-legal">
      <h2 class="eyebrow">Rekvizīti</h2>
      <ul>
        <li>SIA “Auvellora”</li>
        <li>Reģ. Nr. 40203214567</li>
        <li>Katrs eksemplārs — unikāls</li>
      </ul>
    </div>
  </div>

  <div class="wrap foot-base">
    <p>© {year} Auvellora. Visas tiesības aizsargātas.</p>
    <p>Rīga · Latvija</p>
  </div>
</footer>

<style>
  .foot {
    background: var(--ink);
    color: var(--bone);
    padding-block: clamp(3rem, 6vw, 5rem) 2rem;
  }
  .foot-branch {
    max-width: 720px;
    margin: 0 auto clamp(2.5rem, 6vw, 4rem);
    opacity: 0.35;
  }
  .foot-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1.2fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  .foot-brand img { height: 30px; width: auto; margin-bottom: 1.1rem; }
  .foot-brand p { color: var(--bone); opacity: 0.72; font-size: var(--step--1); line-height: 1.6; }
  .foot-col h2 { margin-bottom: 1rem; }
  .foot-col ul { list-style: none; padding: 0; display: grid; gap: 0.55rem; }
  .foot-col a { font-size: var(--step--1); opacity: 0.82; border-bottom: 1px solid transparent; padding-bottom: 1px; }
  .foot-col a:hover { opacity: 1; border-bottom-color: var(--amber); }
  .foot-col li { font-size: var(--step--1); opacity: 0.82; }

  .foot-base {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-bone);
    font-size: var(--step--1);
    opacity: 0.6;
  }

  @media (max-width: 820px) {
    .foot-grid { grid-template-columns: 1fr 1fr; }
    .foot-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 460px) {
    .foot-grid { grid-template-columns: 1fr; }
    .foot-base { flex-direction: column; gap: 0.25rem; }
  }
</style>
