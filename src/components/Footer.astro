---
// Contact details live in one place: src/site.ts.
import { EMAIL } from "../site";
---

<footer class="foot">
  <img class="branch-rule foot-branch" src="/images/branch-bone.png" alt="" width="852" height="361" aria-hidden="true" />
  <div class="wrap foot-grid">
    <div class="foot-brand">
      <img src="/images/wordmark-bone.png" alt="Auvellora" width="3001" height="1501" />
      <p>Objects and interiors from reclaimed wood.<br />Made in Latvia, one at a time.</p>
    </div>

    <nav class="foot-col" aria-label="Footer">
      <h2 class="eyebrow">Pages</h2>
      <ul>
        <li><a href="/elements/">Elements</a></li>
        <li><a href="/interiors/">Interiors</a></li>
        <li><a href="/story/">Story</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </nav>

    <div class="foot-col">
      <h2 class="eyebrow">Contact</h2>
      <ul>
        <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
      </ul>
    </div>
  </div>

  <div class="wrap foot-base">
    <p>© Auvellora</p>
  </div>
</footer>

<style>
  .foot {
    background: var(--ink);
    color: var(--bone);
    padding-block: clamp(3rem, 6vw, 5rem) 2rem;
  }
  .foot-branch {
    max-width: 420px;
    margin: 0 auto clamp(2.5rem, 6vw, 4rem);
    opacity: 0.18;
    mix-blend-mode: screen; /* light drawing on the dark footer */
  }
  .foot-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  .foot-brand img { height: 52px; width: auto; margin: -0.6rem 0 0.6rem -0.5rem; }
  .foot-brand p { color: var(--bone); opacity: 0.72; font-size: var(--step--1); line-height: 1.6; }
  .foot-col h2 { margin-bottom: 1rem; }
  .foot-col ul { list-style: none; padding: 0; display: grid; gap: 0.55rem; }
  .foot-col a { font-size: var(--step--1); opacity: 0.82; border-bottom: 1px solid transparent; padding-bottom: 1px; }
  .foot-col a:hover { opacity: 1; border-bottom-color: var(--amber); }
  .foot-col li { font-size: var(--step--1); opacity: 0.82; overflow-wrap: anywhere; }

  .foot-base {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-bone);
    font-size: var(--step--1);
    opacity: 0.6;
  }

  @media (max-width: 820px) {
    .foot-grid { grid-template-columns: 1fr 1fr; }
    .foot-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 460px) {
    .foot-base { flex-direction: column; gap: 0.25rem; }
  }
</style>
