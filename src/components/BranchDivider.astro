---
// The signature element: a thin branch drawn edge to edge between sections.
// Ink on light sections, bone on dark ones.
import BranchLine from "./BranchLine.astro";

interface Props {
  tone?: "ink" | "bone";
}
const { tone = "ink" } = Astro.props;
---

<div class:list={["branch-divider", `branch-divider--${tone}`]}>
  <BranchLine />
</div>

<style>
  .branch-divider {
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }
  .branch-divider--ink { color: var(--ink); opacity: 0.55; }
  .branch-divider--bone { color: var(--bone); opacity: 0.3; }
</style>
