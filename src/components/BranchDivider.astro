---
// The signature element: the studio's actual driftwood mark, laid as a
// horizontal rule between sections. Bone on dark, ink on light.
interface Props {
  tone?: "ink" | "bone";
  width?: number; // max px
}
const { tone = "ink", width = 620 } = Astro.props;
const src = tone === "bone" ? "/images/branch-bone.png" : "/images/branch-ink.png";
---

<div class="branch-divider" style={`--bw:${width}px`}>
  <img class="branch-rule" src={src} alt="" width="852" height="361" aria-hidden="true" />
</div>

<style>
  .branch-divider {
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }
  .branch-divider .branch-rule {
    max-width: var(--bw);
    margin-inline: auto;
  }
</style>
