---
import Base from "../layouts/Base.astro";
import BranchDivider from "../components/BranchDivider.astro";

// Every line here comes from wording already used on the home, story and
// contact pages, so the Interiors page promises nothing new.
const steps = [
  {
    n: "01",
    t: "Tell us about the space",
    d: "Send a photo of the space and rough dimensions — a corner, a wall, or the whole house. That's where every project begins.",
  },
  {
    n: "02",
    t: "We find the wood",
    d: "We look for wood with a form of its own, in forests, along riverbanks, on the seashore. Together we find the wood that belongs in your space.",
  },
  {
    n: "03",
    t: "Made by hand",
    d: "We prepare, shape and finish every piece by hand in Latvia, with oil or wax in a natural tone. No paint, no imitation.",
  },
];
---

<Base
  title="Interiors — Auvellora"
  description="Commissions in reclaimed wood at any scale, from a single piece to a whole house. Made by hand in Latvia."
>
  <section class="section section-bone page-head page-head--center">
    <div class="wrap--narrow">
      <p class="eyebrow">Interiors</p>
      <h1>One of a kind, at the scale of a room.</h1>
      <p class="lede">
        The Elements are where it begins. The same material and the same care
        can shape something far larger.
      </p>
    </div>
  </section>

  <section class="section section-dark">
    <div class="wrap interiors-grid">
      <div class="interiors-figure reveal">
        <img
          src="/images/interiors-keeper.jpg"
          alt="A Keeper coat stand in a warm living room with a stone fireplace"
          width="1100"
          height="1375"
          loading="lazy"
        />
      </div>
      <div class="interiors-copy reveal">
        <p class="eyebrow">Commissions</p>
        <h2>From a single piece<br />to a whole house.</h2>
        <p>
          A reclaimed-wood wall behind a fireplace, a feature that runs the length
          of a living room, a garden given form. We take commissions at any scale.
        </p>
        <p>
          Every branch arrives with its own history, and no two are alike. So a
          room made with them is one of a kind too: there is no second exactly
          the same, and there never will be.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-bone">
    <div class="wrap">
      <header class="steps-head">
        <p class="eyebrow">How a project begins</p>
        <h2>From your space to the right wood.</h2>
      </header>
      <ol class="steps" style="--cols: 3">
        {
          steps.map((s) => (
            <li class="step reveal">
              <span class="step-n">{s.n}</span>
              <h3 class="step-t">{s.t}</h3>
              <p class="step-d">{s.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
    <BranchDivider tone="ink" />
    <div class="wrap--narrow cta-foot">
      <h2>Planning something larger?</h2>
      <p>Send us a photo of the space and rough dimensions, and we'll start from there.</p>
      <a class="btn" href="/contact/?interest=interior">Start a conversation</a>
    </div>
  </section>
</Base>

<style>
  .interiors-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .interiors-figure img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .interiors-copy h2 { font-size: var(--step-3); margin: 0.5rem 0 1.25rem; }
  .interiors-copy p { color: var(--bone); opacity: 0.82; max-width: 48ch; margin-bottom: 1.15rem; }

  @media (max-width: 860px) {
    .interiors-grid { grid-template-columns: 1fr; }
    .interiors-figure { max-width: 420px; }
    .steps { --cols: 1; }
  }
</style>
