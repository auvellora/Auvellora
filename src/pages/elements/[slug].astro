---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getElements } from "../../elements";

export async function getStaticPaths() {
  const elements = await getElements();
  return elements.map((entry, i) => {
    const prev = elements[(i - 1 + elements.length) % elements.length];
    const next = elements[(i + 1) % elements.length];
    return {
      params: { slug: entry.id },
      props: { entry, prev, next },
    };
  });
}

const { entry, prev, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const ask = `/contact/?interest=element&piece=${encodeURIComponent(d.name)}`;
// With only two pieces, "previous" and "next" are the same one: show it once.
const showPrev = prev.id !== entry.id && prev.id !== next.id;
const showNext = next.id !== entry.id;
---

<Base title={`${d.name} - ${d.type} · Auvellora`} description={d.lead}>
  <article class="pdp section section-bone">
    <div class="wrap pdp-grid">
      <div class="pdp-media">
        <div class="pdp-figure">
          <img src={d.image} alt={d.alt} width="1000" height="1250" fetchpriority="high" />
        </div>
        {
          d.roomImage && (
            <div class="pdp-figure pdp-figure--room">
              <img src={d.roomImage} alt={d.roomAlt ?? ""} width="1000" height="1250" loading="lazy" />
            </div>
          )
        }
      </div>

      <div class="pdp-meta">
        <p class="eyebrow">{d.type}</p>
        <h1>{d.name}</h1>
        <p class="pdp-tagline">{d.tagline}</p>

        <div class="pdp-body">
          <p class="pdp-lead">{d.lead}</p>
          <Content />
        </div>

        <dl class="spec">
          {d.size && (
            <div>
              <dt>Size</dt>
              <dd>{d.size}</dd>
            </div>
          )}
          <div>
            <dt>Materials</dt>
            <dd>{d.materials.join(" · ")}</dd>
          </div>
          {d.light && (
            <div>
              <dt>Light</dt>
              <dd>{d.light}</dd>
            </div>
          )}
          {d.finishes && (
            <div>
              <dt>Finish</dt>
              <dd>{d.finishes.join(" · ")}</dd>
            </div>
          )}
          {d.note && (
            <div>
              <dt>Note</dt>
              <dd>{d.note}</dd>
            </div>
          )}
        </dl>

        <p class="price">Price on request</p>
        <p class="unique">Every piece is one of a kind. We choose the branch together.</p>
        <a class="btn btn--solid" href={ask}>Ask about this piece</a>
      </div>
    </div>

    <nav class="pdp-nav wrap" aria-label="More Elements">
      {
        showPrev ? (
          <a href={`/elements/${prev.id}/`} class="pdp-nav__link">
            <span class="pdp-nav__dir">← Previous</span>
            <span class="pdp-nav__name">{prev.data.name}</span>
          </a>
        ) : (
          <span />
        )
      }
      <a href="/elements/" class="pdp-nav__all">All Elements</a>
      {
        showNext ? (
          <a href={`/elements/${next.id}/`} class="pdp-nav__link pdp-nav__link--next">
            <span class="pdp-nav__dir">Next →</span>
            <span class="pdp-nav__name">{next.data.name}</span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>
</Base>

<style>
  .pdp-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .pdp-media { display: grid; gap: clamp(1rem, 2vw, 1.5rem); }
  .pdp-figure {
    background: var(--bone-2);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .pdp-figure img { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; }

  .pdp-meta { position: sticky; top: 104px; }
  .pdp-meta h1 { font-size: var(--step-3); margin: 0.4rem 0 0.3rem; }
  .pdp-tagline {
    font-family: var(--serif);
    font-size: var(--step-1);
    color: var(--taupe);
    font-style: italic;
    margin-bottom: 1.75rem;
  }
  .pdp-body { max-width: 46ch; margin-bottom: 2.25rem; }
  .pdp-lead { font-size: var(--step-1); line-height: 1.5; margin-bottom: 1rem; }
  .pdp-body :global(p) { margin-bottom: 1rem; color: var(--ink); }

  .spec {
    border-top: 1px solid var(--line-ink);
    margin-bottom: 2rem;
  }
  .spec > div {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line-ink);
  }
  .spec dt {
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--taupe);
  }
  .spec dd { font-size: var(--step-0); }

  .price {
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 0.6rem;
  }
  .unique {
    font-family: var(--serif);
    font-style: italic;
    color: var(--taupe);
    margin-bottom: 1.5rem;
    max-width: 42ch;
  }

  .pdp-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    margin-top: clamp(3.5rem, 8vw, 6rem);
    padding-top: 2rem;
    border-top: 1px solid var(--line-ink);
  }
  .pdp-nav__link { display: grid; gap: 0.2rem; }
  .pdp-nav__link--next { text-align: right; justify-self: end; }
  .pdp-nav__dir {
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--taupe);
  }
  .pdp-nav__name { font-family: var(--serif); font-size: var(--step-1); }
  .pdp-nav__all {
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--taupe);
    border-bottom: 1px solid var(--amber);
    padding-bottom: 2px;
  }

  @media (max-width: 820px) {
    .pdp-grid { grid-template-columns: 1fr; }
    /* phone: main photo, then the text, then the room photo */
    .pdp-media { display: contents; }
    .pdp-figure { max-width: 480px; }
    .pdp-figure--room { order: 1; }
    .pdp-meta { position: static; }
  }
</style>
