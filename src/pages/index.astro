---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ElementCard from "../components/ElementCard.astro";
import BranchDivider from "../components/BranchDivider.astro";

const elements = (await getCollection("elements")).sort(
  (a, b) => a.data.order - b.data.order
);
const featured = elements.slice(0, 2);
---

<Base darkHeader={true}>
  <!-- HERO -->
  <section class="hero section-dark">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Objects and interiors from reclaimed wood</p>
        <h1 class="hero-title">From found wood,<br />one of a kind.</h1>
        <p class="lede">
          We shape branches into objects, and whole spaces, for people who want
          something no one else can have. From a single lamp to an entire room.
        </p>
        <div class="hero-actions">
          <a class="btn btn--solid" href="/elements/">See the Elements</a>
          <a class="link-arrow" href="/interiors/">
            Explore Interiors
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"
              ><path d="M4 12h15M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.6"
                stroke-linecap="round" stroke-linejoin="round"></path></svg
            >
          </a>
        </div>
      </div>
      <div class="hero-figure">
        <img
          src="/images/hero-branch.jpg"
          alt="A found branch on a dark panel, lit with warm light"
          width="332"
          height="667"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- THESIS -->
  <section class="section section-bone">
    <div class="wrap intro">
      <p class="intro-statement">
        We invent nothing. The form is already there, shaped by wind, weather,
        and time. We find the right piece of wood, clean it by hand, and give it
        new life — sometimes as a single lamp, sometimes as an entire room.
      </p>
    </div>
    <BranchDivider tone="ink" />
  </section>

  <!-- ELEMENTS -->
  <section class="section section-bone collection">
    <div class="wrap">
      <header class="collection-head">
        <p class="eyebrow">Elements</p>
        <h2>Made, not manufactured.</h2>
      </header>
      <div class="grid-2">
        {
          featured.map((e, i) => (
            <ElementCard
              slug={e.id}
              name={e.data.name}
              type={e.data.type}
              image={e.data.image}
              alt={e.data.alt}
              tagline={e.data.tagline}
              index={i}
            />
          ))
        }
      </div>
      <p class="collection-more">
        <a class="link-arrow" href="/elements/">
          See all Elements
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"
            ><path d="M4 12h15M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.6"
              stroke-linecap="round" stroke-linejoin="round"></path></svg
          >
        </a>
      </p>
    </div>
  </section>

  <!-- INTERIORS -->
  <section class="section section-dark">
    <div class="wrap interiors-grid">
      <div class="interiors-copy reveal">
        <p class="eyebrow">Interiors</p>
        <h2>One of a kind,<br />at the scale of a room.</h2>
        <p>
          The Elements are where it begins. But the same material and the same
          care can shape something far larger — a reclaimed-wood wall behind a
          fireplace, a feature that runs the length of a living room, a garden
          given form. We take commissions at any scale, from a single piece to a
          whole house.
        </p>
        <a class="btn btn--solid" href="/interiors/">Explore Interiors</a>
      </div>
      <div class="interiors-figure reveal">
        <img
          src="/images/interiors-keeper.jpg"
          alt="A Keeper coat stand in a warm living room with a stone fireplace"
          width="1100"
          height="1375"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- MATERIAL -->
  <section class="section section-bone">
    <div class="wrap material-grid">
      <div class="material-figure reveal">
        <img
          src="/images/bark.jpg"
          alt="Close-up of weathered birch bark, cracked and marked"
          width="820"
          height="1099"
          loading="lazy"
        />
      </div>
      <div class="material-copy reveal">
        <p class="eyebrow">Material</p>
        <h2>Beauty in the imperfect.</h2>
        <p>
          Cracks, moss, worn edges — what's usually called a flaw, we treat as
          the value. Every branch arrives with its own history, and we bring it
          forward rather than hide it.
        </p>
        <p>
          We prepare each piece by hand: cleaned, sanded, finished with oil or wax
          in a natural tone. No paint, no imitation — just wood as it is.
        </p>
      </div>
    </div>
  </section>

  <!-- COMMISSION -->
  <section class="section section-bone commission">
    <div class="wrap--narrow commission-inner">
      <p class="eyebrow">Commissions</p>
      <h2>Every branch is one of a kind.<br />So is yours.</h2>
      <p class="lede">
        Tell us about your space — a corner, a wall, or the whole house.
        Together we find the wood that belongs in it.
      </p>
      <a class="btn" href="/contact/">Start a conversation</a>
    </div>
  </section>
</Base>

<style>
  /* HERO */
  .hero { padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3.5rem, 8vw, 7rem); }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .hero-title {
    font-size: var(--step-4);
    font-weight: 320;
    margin: 0.5em 0 0.55em;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.25rem);
    margin-top: 2.25rem;
    flex-wrap: wrap;
  }
  .hero-figure {
    position: relative;
    justify-self: end;
    max-width: 430px;
    width: 100%;
  }
  .hero-figure::before {
    content: "";
    position: absolute;
    inset: -14% -10% -6% 8%;
    background: radial-gradient(
      55% 42% at 44% 46%,
      rgba(197, 138, 61, 0.42),
      rgba(197, 138, 61, 0) 70%
    );
    filter: blur(6px);
    z-index: 0;
    pointer-events: none;
  }
  .hero-figure img {
    position: relative;
    z-index: 1;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius);
  }

  /* INTRO */
  .intro { max-width: 860px; text-align: center; }
  .intro-statement {
    font-family: var(--serif);
    font-size: var(--step-2);
    line-height: 1.28;
    font-weight: 330;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  /* ELEMENTS */
  .collection { padding-top: 0; }
  .collection-head { margin-bottom: clamp(2rem, 5vw, 3.25rem); }
  .collection-head h2 { font-size: var(--step-3); margin-top: 0.5rem; }
  .grid-2 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    max-width: 960px;
  }
  .collection-more { margin-top: clamp(2rem, 4vw, 3rem); }

  /* INTERIORS */
  .interiors-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .interiors-copy h2 { font-size: var(--step-3); margin: 0.5rem 0 1.25rem; }
  .interiors-copy p { color: var(--bone); opacity: 0.82; max-width: 48ch; margin-bottom: 1.5rem; }
  .interiors-figure img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
  }

  /* MATERIAL */
  .material-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .material-figure { position: relative; max-width: 400px; }
  .material-figure::before {
    content: "";
    position: absolute;
    inset: -8% -6%;
    background: radial-gradient(60% 40% at 50% 42%, rgba(197,138,61,0.22), transparent 72%);
    z-index: 0;
  }
  .material-figure img {
    position: relative;
    z-index: 1;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .material-copy h2 { font-size: var(--step-3); margin: 0.5rem 0 1.25rem; }
  .material-copy p { max-width: 46ch; margin-bottom: 1rem; }

  /* COMMISSION */
  .commission-inner { text-align: center; }
  .commission-inner h2 { font-size: var(--step-3); margin: 0.75rem 0 1.25rem; }
  .commission-inner .lede { margin: 0 auto 2rem; }
  .commission-inner .btn { margin-inline: auto; }

  @media (max-width: 860px) {
    .hero-grid, .interiors-grid, .material-grid { grid-template-columns: 1fr; }
    .hero-figure { justify-self: start; order: -1; max-width: 340px; }
    .interiors-figure { max-width: 420px; }
    .material-figure { max-width: 320px; }
  }
  @media (max-width: 560px) {
    .grid-2 { grid-template-columns: 1fr; }
    /* phone: keep the headline on the first screen */
    .hero-figure { max-width: 230px; }
  }
</style>
