---
import Base from "../layouts/Base.astro";

// ── FORM SETUP ─────────────────────────────────────────────
// A static site can't process a form on its own — it needs an external
// endpoint. Two free options:
//
//  1) Formspree  → set FORM_ENDPOINT to "https://formspree.io/f/xxxxxxx"
//                  (create a form at formspree.io, paste its URL here)
//  2) Netlify Forms → deploy on Netlify, then add  netlify  and a hidden
//                  <input name="form-name" value="kontakts" /> to the <form>.
//
// Until then the form validates in the browser but submissions go nowhere.
const FORM_ENDPOINT = "https://formspree.io/f/your-form-id";
// ───────────────────────────────────────────────────────────
---

<Base
  title="Kontakti — Auvellora"
  description="Sazinieties ar Auvellora: pieprasiet cenu, apspriediet pasūtījumu vai vienkārši uzdodiet jautājumu par objektu no atrasta koka."
>
  <section class="section section-bone page-head">
    <div class="wrap">
      <p class="eyebrow">Kontakti</p>
      <h1>Pastāstiet par savu telpu.</h1>
      <p class="lede">
        Vai interesē konkrēts objekts, vai vēlaties kaut ko pēc pasūtījuma —
        uzrakstiet dažus vārdus, un mēs atbildēsim.
      </p>
    </div>
  </section>

  <section class="section section-bone contact">
    <div class="wrap contact-grid">
      <aside class="contact-info">
        <div class="info-block">
          <h2 class="eyebrow">Tiešais kontakts</h2>
          <ul>
            <li><a href="tel:+37125400100">+371 25 400 100</a></li>
            <li><a href="mailto:studija@auvellora.lv">studija@auvellora.lv</a></li>
          </ul>
        </div>
        <div class="info-block">
          <h2 class="eyebrow">Darbnīca</h2>
          <p>Miera iela 58<br />Rīga, LV-1013</p>
          <p class="muted">Apmeklējums pēc iepriekšējas norunas.</p>
        </div>
        <div class="info-block">
          <h2 class="eyebrow">Pēc pasūtījuma</h2>
          <p class="muted">
            Katru objektu var pielāgot. Atsūtiet telpas foto un aptuvenus
            izmērus — no tā sākam.
          </p>
        </div>
      </aside>

      <form class="form" action={FORM_ENDPOINT} method="post">
        <div class="field">
          <label for="name">Vārds</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
        </div>

        <div class="field-row">
          <div class="field">
            <label for="email">E-pasts</label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="field">
            <label for="phone">Tālrunis <span class="opt">(neobligāti)</span></label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" />
          </div>
        </div>

        <div class="field">
          <label for="interest">Kas jūs interesē?</label>
          <select id="interest" name="interest">
            <option value="kolekcija">Objekts no kolekcijas</option>
            <option value="pasutijums">Objekts pēc pasūtījuma</option>
            <option value="cits">Cits jautājums</option>
          </select>
        </div>

        <div class="field">
          <label for="message">Ziņa</label>
          <textarea id="message" name="message" rows="5" required
            placeholder="Pastāstiet par telpu, objektu vai ideju…"></textarea>
        </div>

        <button class="btn btn--solid" type="submit">Nosūtīt pieprasījumu</button>
        <p class="form-note">Atbildam parasti 1–2 darba dienu laikā.</p>
      </form>
    </div>
  </section>
</Base>

<style>
  .page-head h1 { font-size: var(--step-3); margin: 0.5rem 0 1rem; }
  .page-head .lede { max-width: 50ch; }

  .contact { padding-top: 0; }
  .contact-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .info-block { margin-bottom: 2.25rem; }
  .info-block h2 { margin-bottom: 0.85rem; }
  .info-block ul { list-style: none; padding: 0; display: grid; gap: 0.4rem; }
  .info-block a { border-bottom: 1px solid transparent; padding-bottom: 1px; }
  .info-block a:hover { border-bottom-color: var(--amber); }
  .info-block p { margin-bottom: 0.4rem; }
  .muted { color: var(--taupe); font-size: var(--step--1); max-width: 34ch; }

  .form {
    background: var(--bone-2);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: var(--radius);
    border: 1px solid var(--line-ink);
  }
  .field { margin-bottom: 1.25rem; }
  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  label {
    display: block;
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--taupe);
    margin-bottom: 0.5rem;
  }
  .opt { text-transform: none; letter-spacing: 0; }
  input, select, textarea {
    width: 100%;
    font-family: var(--sans);
    font-size: var(--step-0);
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line-ink);
    border-radius: var(--radius);
    padding: 0.75em 0.85em;
    transition: border-color 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }
  textarea { resize: vertical; min-height: 7rem; }
  input:focus, select:focus, textarea:focus {
    outline: none;
    border-color: var(--amber);
    box-shadow: 0 0 0 3px rgba(197, 138, 61, 0.22);
  }
  .form .btn { margin-top: 0.5rem; }
  .form-note { font-size: var(--step--1); color: var(--taupe); margin-top: 1rem; }

  @media (max-width: 860px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 460px) {
    .field-row { grid-template-columns: 1fr; }
  }
</style>
